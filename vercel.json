{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index premium.html/index premium.html"
    },
    {
      "source": "/styles-premium.css",
      "destination": "/index premium.html/styles-premium.css"
    },
    {
      "source": "/app-premium.js",
      "destination": "/index premium.html/app-premium.js"
    },
    {
      "source": "/data.js",
      "destination": "/index premium.html/data.js"
    },
    {
      "source": "/gemini-bot.js",
      "destination": "/index premium.html/gemini-bot.js"
    },
    {
      "source": "/state-guides.js",
      "destination": "/index premium.html/state-guides.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://translate.google.com https://translate.googleapis.com; connect-src 'self' https://generativelanguage.googleapis.com https://translate.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=()" }
      ]
    }
  ]
}

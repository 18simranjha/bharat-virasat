# Copy this file to .env and replace the placeholder with your Gemini API key.
GEMINI_API_KEY=paste_your_key_here
# Change this if your Google AI Studio account uses another available model.
GEMINI_MODEL=gemini-2.5-flash
PORT=8000
# Set this to the exact public frontend URL when frontend and backend are deployed separately.
ALLOWED_ORIGIN=http://127.0.0.1:8000
